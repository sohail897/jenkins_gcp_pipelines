// Pipeline 3: Cloud SQL (target_table) to GCS prefix sql-exports/ (feeds Pipeline 4).
// Run Pipeline 2 first so target_table contains the rows you intend to export.

pipeline {
    agent { label 'gcp-slave' }

    stages {
        stage('Authenticate GCP') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'gcloud auth activate-service-account --key-file=$GCP_SA_KEY'
                }
            }
        }

        stage('Export Cloud SQL to CSV') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'python3 scripts/export_sql_to_csv.py --host "$CSQL_H" --db "$CSQL_D" --user "$CSQL_U" --password "$CSQL_P" --table target_table --output /tmp/cloudsql_export.csv'
                }
            }
        }

        stage('Upload to GCS') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'gcloud auth activate-service-account --key-file=$GCP_SA_KEY && gsutil cp /tmp/cloudsql_export.csv gs://${GCS_BUCKET}/sql-exports/export_$(date +%Y%m%d_%H%M%S).csv'
                }
            }
        }

        stage('Verify GCS upload') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'gcloud auth activate-service-account --key-file=$GCP_SA_KEY && gsutil ls -l gs://${GCS_BUCKET}/sql-exports/'
                }
            }
        }




    }
    post { success { echo 'P3 done: Cloud SQL to GCS' } failure { echo 'P3 FAILED' } }
}
