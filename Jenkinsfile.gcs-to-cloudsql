pipeline {
    agent { label 'gcp-slave' }
    stages {
        stage('Authenticate GCP') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'gcloud auth activate-service-account --key-file=$GCP_SA_KEY'
                }
            }
        }

        stage('Download from GCS') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh '''#!/bin/bash
set -euo pipefail
gcloud auth activate-service-account --key-file=$GCP_SA_KEY
LATEST=$(gsutil ls gs://$GCS_BUCKET/bq-exports/*.csv 2>/dev/null | tail -n1 || true)
test -n "$LATEST" || { echo "Run Pipeline 1 first: no bq-exports CSV"; exit 2; }
gsutil cp "$LATEST" /tmp/input.csv
'''
                }
            }
        }

        stage('Validate CSV') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'python3 -c "import pandas as pd,sys; df=pd.read_csv(\\"/tmp/input.csv\\"); print(df.shape); sys.exit(1 if df.empty or df.iloc[:,0].isnull().any() else 0)"'
                }
            }
        }

        stage('Load to Cloud SQL') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'python3 scripts/load_gcs_to_sql.py --csv-file /tmp/input.csv --host "$CSQL_H" --db "$CSQL_D" --user "$CSQL_U" --password "$CSQL_P" --table target_table --chunk-size 500'
                }
            }
        }

        stage('Verify Cloud SQL') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY'), string(credentialsId: 'gcs-bucket-name', variable: 'GCS_BUCKET'), string(credentialsId: 'cloudsql-host', variable: 'CSQL_H'), string(credentialsId: 'cloudsql-db', variable: 'CSQL_D'), string(credentialsId: 'cloudsql-user', variable: 'CSQL_U'), string(credentialsId: 'cloudsql-pass', variable: 'CSQL_P')]) {
                    sh 'MYSQL_PWD="$CSQL_P" mysql -h "$CSQL_H" -u "$CSQL_U" "$CSQL_D" -e "SELECT COUNT(*) AS row_count FROM target_table"'
                }
            }
        }
    }
    post {
        success { echo 'P2 done: GCS to Cloud SQL' }
        failure { echo 'P2 FAILED' }
    }
}
